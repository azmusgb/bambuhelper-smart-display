{
  "$schema": "https://json.schemastore.org/design-tokens",
  "system": {
    "name": "LocalAI Appliance Design System",
    "version": "1.0.0",
    "brand": "LocalAI",
    "surfaces": ["appliance-hub", "workshop-terminal", "materials-hub", "satellites"]
  },
  "colors": {
    "palette": {
      "bg": { "value": "#0a111c", "rgb565": "0x0843", "description": "Canonical canvas midnight navy" },
      "bg2": { "value": "#0c1828", "rgb565": "0x08c5", "description": "Secondary canvas background" },
      "surface": { "value": "#121b2b", "rgb565": "0x10e5", "description": "Card, panel, and row surface" },
      "surface2": { "value": "#172238", "rgb565": "0x1927", "description": "Raised and elevated surface" },
      "surface3": { "value": "#182b45", "rgb565": "0x1968", "description": "High elevation surface" },
      "line": { "value": "#1b2740", "rgb565": "0x1948", "description": "Subtle borders and separators" },
      "line2": { "value": "#2d4a6d", "rgb565": "0x2a4d", "description": "Interactive and active borders" },
      "lineCard": { "value": "#1f2c42", "rgb565": "0x1d68", "description": "Standard card outline" },
      "text": { "value": "#eaf0f8", "rgb565": "0xef7f", "description": "Primary high-contrast text" },
      "soft": { "value": "#c3d3e3", "rgb565": "0xc69c", "description": "Body and secondary text" },
      "muted": { "value": "#93a4bc", "rgb565": "0x9537", "description": "Subtitles, metadata, and unknown states" },
      "faint": { "value": "#8698b1", "rgb565": "0x84d6", "description": "Lowest emphasis captions" },
      "accent": { "value": "#6cb6ff", "rgb565": "0x6dbf", "description": "Electric blue interaction accent" },
      "accentText": { "value": "#7cc0ff", "rgb565": "0x7e1f", "description": "Accent text on dark surface" },
      "accentSoft": { "value": "rgba(108,182,255,0.14)", "description": "Accent background tint" },
      "good": { "value": "#3ed598", "rgb565": "0x3eb3", "description": "Healthy, complete, success" },
      "goodBg": { "value": "#102a26", "rgb565": "0x1144", "description": "Success background tint" },
      "attention": { "value": "#ffb224", "rgb565": "0xfd84", "description": "Work in progress, heating, warning" },
      "attentionBg": { "value": "#2a2414", "rgb565": "0x2922", "description": "Attention background tint" },
      "bad": { "value": "#ff6b6b", "rgb565": "0xfb4d", "description": "Fault, error, destructive" },
      "badBg": { "value": "#2b1414", "rgb565": "0x28a2", "description": "Fault background tint" },
      "violet": { "value": "#a99cff", "rgb565": "0xa4df", "description": "Secondary entity / automation accent" }
    }
  },
  "typography": {
    "fontFamily": "Figtree, system-ui, -apple-system, sans-serif",
    "fontFamilyMono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
    "scale": {
      "badge": "11px",
      "fs1": "13px",
      "fs2": "15px",
      "fs3": "17px",
      "fs4": "22px",
      "fs5": "28px",
      "hero": "clamp(34px, 5vw, 56px)"
    }
  },
  "radii": {
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "pill": "999px"
  },
  "shadows": {
    "ambient": "0 20px 55px rgba(0, 0, 0, 0.35)",
    "brandmark": "0 10px 34px rgba(111, 132, 255, 0.28)"
  }
}
