  hubUi13InfoRow(hubUi13RowRect(1),"Smart Plug",plugReady?"Ready":(mapped?"Needs setup":"Not mapped"),"Address and plug type stay in Local Portal",plugReady?C10_GREEN:C10_MUTED);
  hubUi13ToggleRow(hubUi13RowRect(2),"Automatic Power Off",mapped&&tasmotaSettings[plug].autoOffEnabled?"Turns off after a completed print":"Requires mapped smart plug",mapped&&tasmotaSettings[plug].autoOffEnabled,C10_ACCENT);
  hubV1125Action(hubUi13BackRect(),"Back",C10_ACCENT,true,false);hubV1125Action(hubUi13ActionRect(),"Power Options",C10_ACCENT,mapped,false);
  hubMarkFrameDirty();g_dirty=false;
}

static void drawUi13PowerOptions() {
  const bool configured=isAnyPrinterConfigured();const uint8_t plug=configured?hubPowerConfigPlug():0xFF;const bool mapped=plug!=0xFF;
  tft.fillScreen(C10_BG);drawHeader("Power Options",mapped?"Mapped":"Unavailable",3);uiBottomNav(3,nullptr);
  if(mapped){TasmotaSettings& ps=tasmotaSettings[plug];char delay[20];snprintf(delay,sizeof(delay),"%u min",(unsigned)ps.autoOffDelayMin);hubUi13StepperRow(hubUi13RowRect(0),"Auto-Off Delay",delay,"Preset delay after print completion",C10_ACCENT);hubUi13ToggleRow(hubUi13RowRect(1),"Cancel on Door","Opening the printer door cancels pending auto-off",ps.autoOffCancelOnDoor,C10_ACCENT);hubUi13InfoRow(hubUi13RowRect(2),"Advanced Power Setup","Local Portal","Plug address, type and wiring are admin settings",C10_MUTED);}else{hubUi13InfoRow(hubUi13RowRect(0),"Smart Plug","Not mapped","Configure a printer power mapping in Local Portal",C10_MUTED);}
  hubV1125Action(hubUi13BackRect(),"Back",C10_ACCENT,true,false);hubV1125Action(hubUi13ActionRect(),"Local Portal",C10_ACCENT,true,false);
