// Workshop OS 12.4: Premium Interaction Logic
// Implements Bottom-Nav hit-testing, Bento-grid routing, and Radial Stop-hold.

#include "tabs_layout.hpp"

using namespace workshop::ui::tabs;

// ---- Internal State ----
static bool g_wtStopHoldStarted = false;
static bool g_wtStopHoldValid = false;
static long g_wtStopStartTime = 0;

// ---- Bottom Nav Touch ----
static bool wtBottomNavTouch(int16_t x, int16_t y) {
  const wsm::Screen s = wsScreen();
  for (uint8_t i = 0; i < kTabCount; ++i) {
    if (bottomTabRect(s, i).contains(x, y)) {
      wtTab(i); // Tab switch logic
      return true;
    }
  }
  return false;
}

// ---- Bento Home Interaction ----
static bool wtHomeTouch(int16_t x, int16_t y) {
  const wsm::Screen s = wsScreen();
  const ViewSpec& v = view(View::Home);
  
  // 1. Check Bottom Nav first
  if (wtBottomNavTouch(x, y)) return true;

  // 2. Bento Hit-Testing
  for (uint8_t i = 0; i < v.itemCount; ++i) {
    Rect r = itemRect(s, v, 0, 0, i);
    if (r.contains(x, y) && v.items[i].tappable) {
      switch (v.items[i].id) {
        case ItemId::HomeMainCard:
          if (workshopPlatformState().configuredPrinterCount > 0) setPage(SCREEN_HUB_PRINTER);
          else wsOpenFrom(wsm::PageId::LocalPortal, 0);
          break;
        case ItemId::HomeAiAlerts:
          // Open Local AI as a Slide-up Sheet instead of full page
          setPage(SCREEN_HUB_WORKSHOP); 
          g_wtAiOverlay = 1; // Trigger Slide-up state
          break;
        case ItemId::HomeTimerWidget:
          startWorkshopTimer(wtTimerLength());
          break;
        default: break;
      }
      wsClick();
      g_dirty = true;
      return true;
    }
  }
  return false;
}

// ---- Radial Stop-Hold Logic ----
static bool wtStopHoldTrack(int16_t x, int16_t y, wsm::Rect& drawn) {
  const bool onPage = getScreenState() == SCREEN_HUB_PRINTER && wtPrinterView() == View::PrinterControl;
  const WtPrint w = wtPrint();
  
  // Define the target area for the stop button
  const wsm::Screen s = wsScreen();
  const ViewSpec& v = view(View::PrinterControl);
  Rect stopRect = itemRect(s, v, 0, 0, (uint8_t)(v.itemCount - 1));
  
  const bool on = onPage && w.stopEnabled && stopRect.contains(x, y);
  
  if (!g_wtStopHoldStarted) { 
    g_wtStopHoldStarted = true; 
    g_wtStopStartTime = millis();
    g_wtStopHoldValid = on; 
  } else if (!on) {
    g_wtStopHoldValid = false;
  }

  if (!g_wtStopHoldValid) return false;

  // Provide the radial progress data for the renderer
  RadialProgress p = calculateStopProgress(millis(), g_wtStopStartTime, 1000); // 1s hold
  drawn = stopRect; // Pass the rect for the radial center
  return true;
}

static bool wtStopHoldConsume() {
  const bool ok = g_wtStopHoldStarted && g_wtStopHoldValid;
  g_wtStopHoldStarted = false;
  g_wtStopHoldValid = false;
  return ok;
}

// ---- Printer Interaction ----
static bool wtPrinterTouch(int16_t x, int16_t y, bool longPress) {
  const bool stopHeld = wtStopHoldConsume();
  if (wtBottomNavTouch(x, y)) return true;

  const wsm::Screen s = wsScreen();
  const View id = wtPrinterView();
  const ViewSpec& v = view(id);
  
  // Logic for segments (Status/AMS/Control) - now as a floating chip or sub-header
  // ... (segment hit testing remains similar but visually updated) ...

  if (id == View::PrinterControl) {
    // Handle Stop hold specifically
    if (longPress && stopHeld) {
       workshopPlatformDispatchPrinterCommand(0, workshop::platform::PrinterCommand::Stop, true);
       setPrinterFeedback(3, "Stopped", 1800);
       return true;
    }
  }
  
  // Standard Item Hit-Testing
  for (uint8_t i = 0; i < v.itemCount; ++i) {
    Rect r = itemRect(s, v, 0, 0, i);
    if (r.contains(x, y) && v.items[i].tappable) {
       // ... command routing ...
       wsClick();
       return true;
    }
  }
  return false;
}
